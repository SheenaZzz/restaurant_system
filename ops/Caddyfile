# ===========================================================================
# Development / LAN testing on an iPad
# ---------------------------------------------------------------------------
# Caddy's built-in CA signs a certificate for the LAN IP. An iPad has to **trust**
# the root certificate once; the steps are in RUNBOOK.md.
#
# ⚠️ 192.168.1.148 comes from DHCP and can change when the router restarts.
#    When it does, edit it here and `docker compose --profile lan restart caddy`.
#    The long-term fix is a DHCP reservation on the router (DEPLOYMENT.md 2.4).
# ===========================================================================

{
	# Signed by Caddy's local CA rather than Let's Encrypt
	# (a public CA will not sign for a private IP)
	local_certs
}

# ⚠️ Why a hostname rather than an IP:
#    over HTTPS to an IP the client **sends no SNI** -- RFC 6066 says SNI can
#    only be a hostname, never an IP literal. With no SNI, Caddy matches no site
#    and refuses the handshake (curl reports SEC_E_ILLEGAL_MESSAGE).
#
#    sheena.local goes over mDNS (Bonjour), native on iOS and built into Windows 10+.
#    It also survives a DHCP address change.
#
#    This is exactly why production insists on a domain rather than a bare IP.
https://sheena.local, https://localhost {
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# SPA: any unknown path falls back to index.html,
		# so opening the app offline still gets in
		try_files {path} /index.html
		file_server
	}

	encode gzip

	log {
		output stdout
		format console
	}
}

# A plaintext HTTP site, purely for the contrast experiment:
# the same app over :8080 fails to register a Service Worker,
# so reopening it offline is a blank page.
http://sheena.local:8080, http://192.168.1.148:8080, http://localhost:8080 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# ===========================================================================
# Production (the store's server) -- enabled once a domain is bought; delete the two blocks above
# ---------------------------------------------------------------------------
# The point: a DNS-01 challenge **needs no inbound port**, only the ability to
# edit a DNS record. So a domain resolving to a LAN address can get a real
# certificate, and no iPad has to install anything.
#
# ⚠️ Needs a Caddy image with the Cloudflare DNS plugin; the official image has none:
#      xcaddy build --with github.com/caddy-dns/cloudflare
# ===========================================================================

