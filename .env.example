# Copy to .env and edit. .env is gitignored and must never be committed.
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change_me_local_dev

# Front-end origins allowed in development (the Vite dev server). Production is same-origin and needs none.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT signing key. Production has to use a random value:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev_only_change_me
